# Copiar este archivo como ".env" y completar.

PORT=3000

# URL pública del sitio (obligatoria en producción, con https).
# Se usa para las redirecciones y el webhook de Mercado Pago.
# PUBLIC_URL=https://www.tubarberia.com

# Usuario del dueño. Se crea la primera vez que arranca el servidor.
# Si no definís ADMIN_PASSWORD, se genera una clave aleatoria y se muestra en la consola.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Mercado Pago (Checkout Pro). Access Token de la cuenta del dueño.
# Si queda vacío, el sitio funciona en MODO DEMO (pago simulado, sin cobrar).
MP_ACCESS_TOKEN=
